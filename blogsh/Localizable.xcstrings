    "User": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel"
          }
        }
      }
    },
    "What do you want to do?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co chceš dělat?"
          }
        }
      }
    },
    "With a network configured it announces too, which nothing takes back.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zároveň se oznámí na síti — a oznámení nejde vzít zpět."
          }
        }
