    },
    "Take the %@ text off '%@'? The post then looks exactly as it did before the translation existed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat text v jazyce %@ z '%@'? Příspěvek pak vypadá přesně jako před překladem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Text auf %1$@ von „%2$@“ entfernen? Der Beitrag sieht dann genau so aus wie vor der Übersetzung."
          }
        }
      }
    },
    "Take the text as the blog has it": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzít text tak, jak je na blogu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Text nehmen, wie er im Blog steht"
          }
        }
      }
    },
    "Take this language off the post": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat tenhle jazyk z příspěvku"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sprache vom Beitrag entfernen"
          }
        }
      }
    },
    "Taken off": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebráno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt"
          }
        }
      }
    },
    "Tap a colour to change it. It holds on this device, for every blog.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím na políčko barvu změníš. Platí na tomto zařízení a pro všechny blogy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Feld, um die Farbe zu ändern. Gilt auf diesem Gerät, für jeden Blog."
          }
        }
      }
    },
    "Test the connection": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyzkoušet spojení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung testen"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text"
          }
        }
      }
    },
    "Text size": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velikost písma"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schriftgröße"
          }
        }
      }
    },
    "The app has no key yet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Appka ještě nemá klíč."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App hat noch keinen Schlüssel."
          }
        }
      }
    },
    "The app speaks the chosen language after it is started again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoleným jazykem appka promluví po novém spuštění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählte Sprache spricht die App nach dem nächsten Start."
          }
        }
      }
    },
    "The app wears the colours of the blog that is open, its default ones, or the ones chosen here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Appka nosí barvy otevřeného blogu, své výchozí, nebo ty, které si tu zvolíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App trägt die Farben des geöffneten Blogs, ihre Standardfarben oder die hier gewählten."
          }
        }
      }
    },
    "The archive": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiv"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Archiv"
          }
        }
      }
    },
    "The blog's settings": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení blogu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen des Blogs"
          }
        }
      }
    },
    "The chosen colours cannot be read here, so this part keeps to the default scheme until they can.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolené barvy se tu nedají číst, proto tenhle oddíl zůstává ve výchozím schématu, dokud to nepůjde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählten Farben sind hier nicht lesbar, deshalb bleibt dieser Abschnitt im Standardschema, bis sie es sind."
          }
        }
      }
    },
    "The default scheme": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí schéma"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardschema"
          }
        }
      }
    },
    "The engine did not answer as data: %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine neodpověděl daty: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine hat nicht mit Daten geantwortet: %@"
          }
        }
      }
    },
    "The first is the size the system has; the others are steps above it. It holds on this device, for every blog.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První je velikost, jakou má systém; další jsou stupně nad ní. Platí na tomto zařízení a pro všechny blogy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste ist die Größe, die das System hat; die anderen sind Stufen darüber. Sie gilt auf diesem Gerät, für jedes Blog."
          }
        }
      }
    },
    "The header and the text, as the editor opens them. A picture is named by its file name.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavička a text, jak je otevírá editor. Obrázek je pojmenovaný svým souborem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopf und Text, wie der Editor sie öffnet. Ein Bild heißt wie seine Datei."
          }
        }
      }
    },
    "The key is made on this device and never leaves it. Put the line above into the server's ~/.ssh/authorized_keys; the forced command in front of it is what the key may run, and nothing else.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč vzniká na tomhle zařízení a nikdy ho neopustí. Řádek výše dej na serveru do ~/.ssh/authorized_keys; forced command před ním je vše, co klíč smí spustit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel entsteht auf diesem Gerät und verlässt es nie. Die Zeile oben gehört auf dem Server in ~/.ssh/authorized_keys; der forced command davor ist alles, was der Schlüssel ausführen darf."
          }
        }
      }
    },
    "The last %@ posts of %@, as ./blog.sh offers them. Looking for an older one?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posledních %1$@ příspěvků z %2$@, stejně jako v ./blog.sh. Hledáš starší?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten %1$@ Beiträge von %2$@, wie ./blog.sh sie anbietet. Suchst du einen älteren?"
          }
        }
      }
    },
    "The line for the server's ~/.ssh/authorized_keys is made from where the blog is. A blog inside a container is reached through the command that enters it, for example sudo docker exec -i blog; one that is not in a container leaves that field empty.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řádek pro ~/.ssh/authorized_keys na serveru se složí z toho, kde blog leží. K blogu v kontejneru se jde přes příkaz, který do něj vstoupí, například sudo docker exec -i blog; u blogu mimo kontejner zůstává to pole prázdné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeile für ~/.ssh/authorized_keys auf dem Server entsteht daraus, wo das Blog liegt. Ein Blog in einem Container erreicht man über den Befehl, der ihn betritt, zum Beispiel sudo docker exec -i blog; liegt das Blog in keinem Container, bleibt dieses Feld leer."
          }
        }
      }
    },
    "The old address keeps answering: it redirects to the new one.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stará adresa dál odpovídá: přesměruje na novou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alte Adresse antwortet weiter: sie leitet auf die neue um."
          }
        }
      }
    },
    "The original": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Originál"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original"
          }
        }
      }
    },
    "The post goes to the trash and can be restored.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvek jde do koše a dá se obnovit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag kommt in den Papierkorb und lässt sich wiederherstellen."
          }
        }
      }
    },
    "The post goes to the trash and can be restored; its announcement goes with it and cannot.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvek jde do koše a dá se obnovit; jeho oznámení zmizí s ním a obnovit nejde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag kommt in den Papierkorb und lässt sich wiederherstellen; seine Ankündigung geht mit und lässt sich nicht zurückholen."
          }
        }
      }
    },
    "The post has changed on the blog since; saving puts this text in its place.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvek se mezitím na blogu změnil; uložením ho tenhle text nahradí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag hat sich im Blog seitdem geändert; beim Speichern tritt dieser Text an seine Stelle."
          }
        }
      }
    },
    "The post is in the trash and can be restored from there.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvek je v koši a dá se odtud obnovit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag liegt im Papierkorb und lässt sich von dort wiederherstellen."
          }
        }
      }
    },
    "The post is live: saving rebuilds and deploys the site.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvek je živý: uložení web sestaví a nasadí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag ist live: Speichern baut die Website neu und liefert sie aus."
          }
        }
      }
    },
    "The post keeps its text and loses only the plan.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvek si nechá text a přijde jen o plán."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag behält seinen Text und verliert nur den Plan."
          }
        }
      }
    },
    "The post stays a draft, with the date it had before the plan.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvek zůstane konceptem, s datem, které měl před naplánováním."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag bleibt Entwurf, mit dem Datum, das er vor dem Plan hatte."
          }
        }
      }
    },
    "The post, its media and its history come back where they were.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvek, jeho média i historie se vrátí, kde byly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag, seine Medien und seine Geschichte kommen dorthin zurück, wo sie waren."
          }
        }
      }
    },
    "The posts in between step back one slot each; the same times stay occupied.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvky mezi tím ustoupí každý o slot; obsazené časy zůstanou tytéž."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beiträge dazwischen rücken je einen Slot zurück; belegt bleiben dieselben Zeiten."
          }
        }
      }
    },
    "The queue is empty": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fronta je prázdná"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Warteschlange ist leer"
          }
        }
      }
    },
    "The same as publishing a draft by hand, announcement included.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Totéž jako ruční publikace konceptu, včetně oznámení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe wie einen Entwurf von Hand zu veröffentlichen, samt Ankündigung."
          }
        }
      }
    },
    "The schedule is cancelled; the post is a draft again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plán je zrušený, příspěvek je zase koncept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan ist aufgehoben, der Beitrag ist wieder ein Entwurf."
          }
        }
      }
    },
    "The scheduled-post queue": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fronta naplánovaných příspěvků"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Warteschlange der geplanten Beiträge"
          }
        }
      }
    },
    "The sentences are the blog's own, in the blog's language. Nothing is repaired from here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Věty jsou vlastní slova blogu, v jeho jazyce. Odsud se nic neopravuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sätze sind die des Blogs, in seiner Sprache. Von hier aus wird nichts repariert."
          }
        }
      }
    },
    "The server closed the connection without an answer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server zavřel spojení bez odpovědi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Verbindung ohne Antwort geschlossen."
          }
        }
      }
    },
    "The server does not know this blog's key. The line under the key in the blog's settings belongs in ~/.ssh/authorized_keys on the server.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server klíč tohoto blogu nezná. Řádek pod klíčem v nastavení blogu patří na serveru do ~/.ssh/authorized_keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server kennt den Schlüssel dieses Blogs nicht. Die Zeile unter dem Schlüssel in den Einstellungen des Blogs gehört auf dem Server in ~/.ssh/authorized_keys."
          }
        }
      }
    },
    "The server is not set up yet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server ještě není nastavený."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist noch nicht eingerichtet."
          }
        }
      }
    },
    "The server's key changed (%@). If the server was reinstalled, forget the old key in the blog's settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč serveru se změnil (%@). Pokud byl server přeinstalovaný, zapomeň starý klíč v nastavení blogu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel des Servers hat sich geändert (%@). Wurde der Server neu aufgesetzt, vergiss den alten Schlüssel in den Einstellungen des Blogs."
          }
        }
      }
    },
    "The site": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Web"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Website"
          }
        }
      }
    },
    "The site could not be built: %@ It can be tried again under The site.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Web se nepodařilo sestavit: %@ Znovu to jde zkusit na obrazovce Web."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Website ließ sich nicht bauen: %@ Unter „Website“ lässt es sich erneut versuchen."
          }
        }
      }
    },
    "The site does not show this change yet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Web tuhle změnu ještě neukazuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Website zeigt diese Änderung noch nicht."
          }
        }
      }
    },
    "The site has no address set, so there is nothing to open.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Web nemá nastavenou adresu, takže není co otevřít."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Website hat keine Adresse gesetzt, es gibt also nichts zu öffnen."
          }
        }
      }
    },
    "The site will be built in a moment.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za okamžik web sestavím."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Website wird gleich gebaut."
          }
        }
      }
    },
    "The text did not come with the answer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text v odpovědi nepřišel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text kam nicht mit der Antwort."
          }
        }
      }
    },
    "The text names fewer pictures than the post has. From the app a picture can be swapped for another, not taken out: the blog refuses a save that would leave the post with fewer. Taking pictures out is done at the desk, with ./blog.sh edit.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text jmenuje méně obrázků, než příspěvek má. Z appky jde obrázek vyměnit za jiný, ne ubrat: uložení, po kterém by jich zbylo méně, blog odmítne. Ubrat obrázky jde u stolu přes ./blog.sh edit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text nennt weniger Bilder, als der Beitrag hat. Aus der App lässt sich ein Bild gegen ein anderes tauschen, nicht herausnehmen: das Blog lehnt ein Speichern ab, nach dem der Beitrag weniger hätte. Bilder herausnehmen geht am Schreibtisch, mit ./blog.sh edit."
          }
        }
      }
    },
    "The time offered is the next free publishing slot.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabídnutý čas je nejbližší volný slot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angebotene Zeit ist der nächste freie Slot."
          }
        }
      }
    },
    "This blog's engine does not offer this check to the app yet. It comes with a newer ./blog.sh.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine tohohle blogu tuhle kontrolu appce zatím nenabízí. Přijde s novějším ./blog.sh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine dieses Blogs bietet der App diese Prüfung noch nicht an. Sie kommt mit einem neueren ./blog.sh."
          }
        }
      }
    },
    "This post cannot be edited here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenhle příspěvek tady upravit nejde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Beitrag lässt sich hier nicht bearbeiten."
          }
        }
      }
    },
    "This post cannot be edited here: %@. At the desk, edit asks before losing it; here nobody could answer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenhle příspěvek tady upravit nejde: %@. U počítače se edit zeptá, než to ztratí; tady by neměl kdo odpovědět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Beitrag lässt sich hier nicht bearbeiten: %@. Am Schreibtisch fragt edit, bevor etwas verloren geht; hier könnte niemand antworten."
          }
        }
      }
    },
    "This post has no old addresses.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenhle příspěvek nemá staré adresy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Beitrag hat keine alten Adressen."
          }
        }
      }
    },
    "This site publishes in more than one language and this post is not written in all of them yet: it would go out in one language only.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Web vychází ve více jazycích a tenhle příspěvek ještě není napsaný ve všech: vyšel by jen v jednom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Website erscheint in mehr als einer Sprache, und dieser Beitrag ist noch nicht in allen geschrieben: er ginge nur in einer Sprache hinaus."
          }
        }
      }
    },
    "Three steps larger": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O tři stupně větší"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Stufen größer"
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Titulek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel"
          }
        }
      }
    },
    "Trash": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koš"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Papierkorb"
          }
        }
      }
    },
    "Trash emptied: %lld item(s), %@ freed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koš vysypán: položek %1$lld, uvolněno %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Papierkorb geleert: %1$lld Element(e), %2$@ freigegeben."
          }
        }
      }
    },
    "Trash is empty": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koš je prázdný"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Papierkorb ist leer"
          }
        }
      }
    },
    "Two posts in different years share this slug, and the app cannot say which of them is meant. At the desk, ./blog.sh props asks which.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenhle slug mají dva příspěvky v různých letech a appka neumí říct, který z nich myslíš. U stolu se na to zeptá ./blog.sh props."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Slug tragen zwei Beiträge aus verschiedenen Jahren, und die App kann nicht sagen, welcher gemeint ist. Am Schreibtisch fragt ./blog.sh props danach."
          }
        }
      }
    },
    "Two steps larger": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O dva stupně větší"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Stufen größer"
          }
        }
      }
    },
    "Unpublish": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhnout z webu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück auf Entwurf"
          }
        }
      }
    },
    "Unpublished; the post is a draft again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Staženo z webu, příspěvek je zase koncept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgesetzt, der Beitrag ist wieder ein Entwurf."
          }
        }
      }
    },
    "Unpublishing…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahuji z webu…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf Entwurf zurückgesetzt…"
          }
        }
      }
    },
    "Unsaved changes": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuložená úprava"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gespeicherte Änderungen"
          }
        }
      }
    },
    "Unsaved translation, %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuložený překlad, %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gespeicherte Übersetzung, %@"
          }
        }
      }
    },
    "Unsent new post": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neodeslaný nový příspěvek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gesendeter neuer Beitrag"
          }
        }
      }
    },
    "Up": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahoru"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoch"
          }
        }
      }
    },
    "Up — a slot earlier": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahoru — o slot dříve"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoch — einen Slot früher"
          }
        }
      }
    },
    "Upload the whole site unchecked": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrát celý web bez kontroly"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ganze Website ungeprüft hochladen"
          }
        }
      }
    },
    "Used in the text": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V textu použit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Text verwendet"
          }
        }
      }
    },
    "User": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzer"
          }
        }
      }
    },
    "Usually only the pages that changed are built. With this on the whole site is built again, which takes longer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běžně se sestaví jen stránky, které se změnily. Se zapnutým přepínačem se sestaví znovu celý web, což trvá déle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalerweise werden nur die geänderten Seiten gebaut. Ist das an, wird die ganze Website neu gebaut, was länger dauert."
          }
        }
      }
    },
    "What do you want to do?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co chceš dělat?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was möchtest du tun?"
          }
        }
      }
    },
    "What is cleared out is gone for good. Older versions are what a post said before its recent saves; each post keeps its newest.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co se uklidí, je pryč nadobro. Starší verze jsou to, co příspěvek říkal před posledními uloženími; každému zůstane ta nejnovější."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was aufgeräumt wird, ist endgültig weg. Ältere Fassungen sind, was ein Beitrag vor seinen letzten Speicherungen sagte; jeder behält seine neueste."
          }
        }
      }
    },
    "With a network configured it announces too, which nothing takes back.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zároveň se oznámí na síti — a oznámení nejde vzít zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem eingerichteten Netzwerk wird auch angekündigt — und eine Ankündigung lässt sich nicht zurücknehmen."
          }
        }
      }
    },
    "Worth a look": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke zvážení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Nachsehen"
          }
        }
      }
    },
    "Your own": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene"
          }
        }
      }
    },
    "a former slug, redirects here": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "bývalý slug, přesměrovává sem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ein früherer Slug, leitet hierher"
          }
        }
      }
    },
    "all": {
